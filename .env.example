# Variables de entorno para el backend de Netlify
# Copia este archivo a .env para desarrollo local
# Configura estas variables en Netlify Dashboard > Site settings > Environment variables

# Clave secreta para JWT (obligatorio)
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui

# URI de la base de datos MongoDB (opcional - sin esto usa datos mock)
DB_URI=mongodb+srv://user:password@cluster.mongodb.net/spotify-clone

# Entorno de ejecución
NODE_ENV=production

# URL pública de tu sitio en Netlify (se asigna automáticamente)
URL_PUBLIC=https://tu-app.netlify.app